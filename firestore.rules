rules_version = '2';

// ============================================================================
// TODO antes del primer cliente real:
// `bots`, `conversations` y `leads` hoy permiten lectura a CUALQUIER usuario
// autenticado (no solo al dueño del negocio) — ver los comentarios en cada
// `match` abajo. Esto es aceptable únicamente mientras todos los datos sean
// de prueba. Antes de dar acceso a un cliente real hay que restringir esas
// lecturas para que cada cliente solo vea sus propios datos, por ejemplo
// guardando un `ownerEmail` (o el ID del documento de `clients`) en cada
// bot/conversación/lead y comparándolo contra request.auth.token.email.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'seacrewagency@gmail.com',
          'hola@veloiapp.com',
          'veloiapp@gmail.com'
        ];
    }

    // clients — creación pública SOLO para registro de trial (trial.html).
    // Lectura: el admin ve todo; un cliente autenticado solo su propio
    // documento (necesario para que client.html pueda encontrarlo por email).
    match /clients/{clientId} {
      allow create: if (request.resource.data.isTrial == true) || isAdmin();
      allow read: if isAdmin() ||
        (request.auth != null && request.auth.token.email == resource.data.email);
      allow update, delete: if isAdmin();
    }

    // bots — mismo patrón de creación que clients (trial.html crea ambos
    // a la vez). Lectura abierta a cualquier autenticado — TODO arriba:
    // falta aislar por dueño antes de tener clientes reales.
    match /bots/{botId} {
      allow create: if (request.resource.data.isTrial == true) || isAdmin();
      allow read: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // conversations — nadie crea aquí hoy (ni liveDemoAgent ni ningún HTML
    // del repo lo hace), así que create/update/delete quedan solo para
    // admin. Lectura abierta a cualquier autenticado — TODO arriba.
    match /conversations/{convId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // leads — igual que conversations, EXCEPTO update/delete: client.html
    // los usa activamente (drag-and-drop del embudo, botón de borrar), así
    // que se quedan abiertos a cualquier autenticado para no romper esa
    // función — solo "create" se restringe a admin (nada los crea hoy).
    // Lectura abierta a cualquier autenticado — TODO arriba.
    match /leads/{leadId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if request.auth != null;
    }

    // onboarding_submissions — formulario público de intake (onboarding.html),
    // sin login. Mismo criterio que trial.html: crear es público, leer/editar
    // solo admin.
    match /onboarding_submissions/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // leads_landing — modal "Solicitar demo" en index.html (sección de
    // precios), sin login, mismo patrón que trial.html/onboarding_submissions:
    // crear es público, leer/editar solo admin.
    match /leads_landing/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ==========================================================================
    // VELOIAPP LEADFLOW — producto nuevo y separado, colecciones propias
    // (leadflow_*), sin tocar clients/bots/conversations/leads de arriba.
    //
    // A diferencia del TODO pendiente en esas colecciones (lectura abierta a
    // cualquier autenticado), aquí el aislamiento por tenant se implementa
    // desde el día uno: cada doc de leads/events/handoffs lleva `companyId`,
    // y el acceso de un usuario no-admin se valida contra
    // `leadflow_companies/{companyId}.allowedUsers`.
    //
    // Nada de esto lo crea un cliente/browser directamente salvo las
    // actualizaciones puntuales del dashboard (mover una tarjeta del embudo,
    // resolver un handoff) — la creación real de leads/events la hacen las
    // Cloud Functions con el Admin SDK, que no pasa por estas reglas.
    // ==========================================================================

    function isLeadflowCompanyMember(companyId) {
      return request.auth != null &&
        request.auth.token.email in
          get(/databases/$(database)/documents/leadflow_companies/$(companyId)).data.allowedUsers;
    }

    // leadflow_companies — configuración del tenant (idioma, reglas de
    // negocio, scoring, booking). Solo admin escribe hoy (se siembra a mano
    // o vía script); los usuarios del negocio solo leen su propia empresa.
    match /leadflow_companies/{companyId} {
      allow read: if isAdmin() || isLeadflowCompanyMember(companyId);
      allow write: if isAdmin();
    }

    // leadflow_leads — creados/analizados solo por las Cloud Functions
    // (Admin SDK). El dashboard puede actualizar (ej. mover de etapa a
    // mano) si el usuario pertenece a la empresa dueña del lead.
    match /leadflow_leads/{leadId} {
      allow read, update: if isAdmin() || isLeadflowCompanyMember(resource.data.companyId);
      allow create, delete: if isAdmin();
    }

    // leadflow_lead_events — historial append-only. Nunca se edita ni se
    // borra desde el cliente; solo lectura para auditoría en el dashboard.
    match /leadflow_lead_events/{eventId} {
      allow read: if isAdmin() || isLeadflowCompanyMember(resource.data.companyId);
      allow create, update, delete: if isAdmin();
    }

    // leadflow_handoffs — cola de casos escalados a humano. El dashboard
    // necesita poder marcarlos como ACKNOWLEDGED/RESOLVED, por eso update
    // está abierto a miembros de la empresa; create solo vía Cloud Function.
    match /leadflow_handoffs/{handoffId} {
      allow read, update: if isAdmin() || isLeadflowCompanyMember(resource.data.companyId);
      allow create, delete: if isAdmin();
    }

    // Cualquier otra colección no listada arriba: denegado explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
