# Solo para el E2E aislado de LeadFlow (tests/leadflow/e2e/run.js).
#
# firebase-tools carga .env.<projectId> únicamente cuando el proyecto activo
# es ese: este archivo solo aplica a `--project demo-leadflow` y nunca al
# proyecto real. Apunta los SDK de Gemini y Resend a los mocks HTTP locales
# que levanta run.js, para que el E2E no haga ninguna petición externa.
#
# Puertos fijos a propósito: el cargador de .env de firebase-tools no hace
# interpolación, así que el puerto tiene que conocerse antes de arrancar el
# emulador. Si están ocupados, run.js aborta antes de ejecutar nada.
GOOGLE_GEMINI_BASE_URL=http://127.0.0.1:9911
RESEND_BASE_URL=http://127.0.0.1:9912
